# Copy to .env and supply your own provider credentials.
# OPENAI_BASE_URL is the API origin; config adds v1/chat/completions.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=

# Configure a reachable Baidu search MCP service for the bundled agents.
BAIDU_SEARCH_MCP_BASE_URI=
BAIDU_SEARCH_MCP_SSE_ENDPOINT=/sse
